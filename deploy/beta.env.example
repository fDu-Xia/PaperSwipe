# Copy to .env.beta in the project root; never commit filled values.
# Exact origin, no trailing slash. Domain must point to the server.
PUBLIC_ORIGIN=https://beta.example.com
# Generate one entry per person using: go run . invite
# Change tester01 to a unique stable id. Separate entries with commas.
BETA_INVITES=
# Start without a model key; verify paper-source connectivity first.
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.5-air
LLM_THINKING=disabled
SEMANTIC_SCHOLAR_API_KEY=
